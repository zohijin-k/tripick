# ──────────────────────────────────────────────────────────────────────────────
# TRIPICK Backend 환경 변수 예시
# 이 파일을 복사해 .env 를 만들고 실제 값을 입력하세요:
#   cp .env.example .env
#
# ⚠️  .env 파일은 .gitignore 에 포함되어 있어 절대 커밋되지 않습니다.
# ⚠️  TourAPI 키는 이 서버(backend)에서만 관리하며, 앱(app) 코드에는 절대 넣지 않습니다.
# ──────────────────────────────────────────────────────────────────────────────

PORT=3000
DATABASE_URL=postgresql://tripick:tripick@localhost:5432/tripick?schema=public
JWT_SECRET=replace_with_long_random_secret

# 한국관광공사 TourAPI v2 서비스 키
# 발급처: https://www.data.go.kr/data/15101578/openapi.do
# ⚠️  반드시 "일반 인증키 (Decoding)" 을 사용하세요.
#     이 값은 axios가 요청 시 자동으로 인코딩하므로, 이미 인코딩된 키를 넣으면 이중 인코딩으로 인증이 실패합니다.
TOUR_API_KEY=your_decoding_tour_api_key

TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService1

# 콤마로 구분된 허용 Origin 목록 (선택). 비워두면 개발 환경에서는 전체 허용됩니다.
# 배포 시에는 반드시 실제 프론트엔드 도메인으로 제한하세요.
# 예: CORS_ORIGINS=https://tripick.app,https://admin.tripick.app
CORS_ORIGINS=
